# LCFLIGHT backend - copy to .env and adjust (nothing is hardcoded in code)

# HTTP server
PORT=3000
NODE_ENV=development

# SQLite
DB_PATH=./data/lcflight.db

# MQTT broker (em uso: HiveMQ publico)
MQTT_BROKER_URL=mqtt://broker.hivemq.com:1883
# Broker local Mosquitto (comentado):
# MQTT_BROKER_URL=mqtt://192.168.100.194:1883
MQTT_USER=
MQTT_PASS=
MQTT_PREFIX=esp32

# OTA forwarding
OTA_PORT=8266
OTA_USER=admin
OTA_PASS=

# Tuning
PROBE_TIMEOUT_MS=3000
COMMAND_TIMEOUT_MS=3000
SSE_HEARTBEAT_MS=15000
TELEMETRY_RETENTION_PER_DEVICE=200

# Production frontend build (served by this backend)
FRONTEND_DIR=../frontend/dist